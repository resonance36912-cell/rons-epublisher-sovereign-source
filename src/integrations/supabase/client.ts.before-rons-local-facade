const DB_NAME="resonance-epublisher-sovereign"; const STORE="files"; const urlCache=new Map<string,string>();
function openDb():Promise<IDBDatabase>{return new Promise((resolve,reject)=>{const r=indexedDB.open(DB_NAME,1);r.onupgradeneeded=()=>{if(!r.result.objectStoreNames.contains(STORE))r.result.createObjectStore(STORE)};r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error);});}
async function filePut(key:string,blob:Blob){const db=await openDb();await new Promise<void>((resolve,reject)=>{const tx=db.transaction(STORE,"readwrite");tx.objectStore(STORE).put(blob,key);tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error)});db.close();}
async function fileGet(key:string):Promise<Blob|null>{const db=await openDb();const v=await new Promise<any>((resolve,reject)=>{const tx=db.transaction(STORE,"readonly");const r=tx.objectStore(STORE).get(key);r.onsuccess=()=>resolve(r.result??null);r.onerror=()=>reject(r.error)});db.close();return v;}
async function fileDelete(key:string){const db=await openDb();await new Promise<void>((resolve,reject)=>{const tx=db.transaction(STORE,"readwrite");tx.objectStore(STORE).delete(key);tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error)});db.close();}
async function fileKeys(prefix:string):Promise<string[]>{const db=await openDb();const keys=await new Promise<string[]>((resolve,reject)=>{const tx=db.transaction(STORE,"readonly");const r=tx.objectStore(STORE).getAllKeys();r.onsuccess=()=>resolve((r.result||[]).map(String).filter(x=>x.startsWith(prefix)));r.onerror=()=>reject(r.error)});db.close();return keys;}
async function objectUrl(key:string){const cached=urlCache.get(key);if(cached)return cached;const b=await fileGet(key);if(!b)return "";const u=URL.createObjectURL(b);urlCache.set(key,u);return u;}
const storage={from(bucket:string){const prefix=`${bucket}/`;return {
  async upload(path:string,file:Blob,_opts?:any){try{const key=prefix+path;await filePut(key,file);const old=urlCache.get(key);if(old)URL.revokeObjectURL(old);urlCache.set(key,URL.createObjectURL(file));return {data:{path,fullPath:key},error:null};}catch(e:any){return {data:null,error:e};}},
  async download(path:string){try{return {data:await fileGet(prefix+path),error:null};}catch(e:any){return {data:null,error:e};}},
  getPublicUrl(path:string){return {data:{publicUrl:urlCache.get(prefix+path)||`resonance-local://${encodeURIComponent(prefix+path)}`}};},
  async createSignedUrl(path:string,_seconds:number,_opts?:any){return {data:{signedUrl:await objectUrl(prefix+path)},error:null};},
  async createSignedUrls(paths:string[],_seconds:number,_opts?:any){return {data:await Promise.all(paths.map(async path=>({path,signedUrl:(await objectUrl(prefix+path))||null,error:null}))),error:null};},
  async remove(paths:string[]){for(const p of paths){const key=prefix+p;const u=urlCache.get(key);if(u)URL.revokeObjectURL(u);urlCache.delete(key);await fileDelete(key);}return {data:paths.map(name=>({name})),error:null};},
  async list(path="",_opts?:any){const keys=await fileKeys(prefix+path);return {data:keys.map(k=>({name:k.slice(prefix.length),id:k,metadata:{}})),error:null};},
  async move(from:string,to:string){const b=await fileGet(prefix+from);if(!b)return {data:null,error:new Error("Local file not found")};await filePut(prefix+to,b);await fileDelete(prefix+from);return {data:{message:"ok"},error:null};},
  async copy(from:string,to:string){const b=await fileGet(prefix+from);if(!b)return {data:null,error:new Error("Local file not found")};await filePut(prefix+to,b);return {data:{path:to},error:null};},
};}};

