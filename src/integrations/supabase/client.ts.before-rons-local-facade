type LocalResult = { data: any; error: any; count?: number | null; status?: number; statusText?: string };
type Filter = { key: string; op: string; value: any };
const TABLE_PREFIX = "resonance:epublisher:table:";
const AUTH_KEY = "resonance:epublisher:local-auth";
function makeId() { return globalThis.crypto?.randomUUID?.() ?? `local-${Date.now()}-${Math.random().toString(16).slice(2)}`; }
function nowIso() { return new Date().toISOString(); }
function signedIn() { try { return localStorage.getItem(AUTH_KEY) !== "signed-out"; } catch { return true; } }
function setSignedIn(v: boolean) { try { localStorage.setItem(AUTH_KEY, v ? "signed-in" : "signed-out"); } catch {} }
function keyForTable(table: string) { return TABLE_PREFIX + table; }
function seedRows(table: string): any[] {
  if (table === "profiles") return [{ id: "local-profile", user_id: LOCAL_USER_ID, display_name: "Sovereign Local User", avatar_url: "", created_at: nowIso(), updated_at: nowIso() }];
  if (table === "user_roles") return [{ id: "local-admin", user_id: LOCAL_USER_ID, role: "admin", created_at: nowIso() }];
  return [];
}
export function readLocalRows(table: string): any[] {
  try {
    const raw = localStorage.getItem(keyForTable(table));
    if (raw) return JSON.parse(raw);
  } catch {}
  return seedRows(table);
}
export function writeLocalRows(table: string, rows: any[]) { try { localStorage.setItem(keyForTable(table), JSON.stringify(rows)); } catch {} }
function cmp(a: any, b: any) { if (a == null && b == null) return 0; return String(a ?? "").localeCompare(String(b ?? ""), undefined, { numeric: true }); }
function like(value: any, pattern: any, ci=false) {
  let a=String(value ?? ""), p=String(pattern ?? ""); if (ci) { a=a.toLowerCase(); p=p.toLowerCase(); }
  const re=new RegExp("^"+p.split("%").map(x=>x.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")).join(".*")+"$"); return re.test(a);
}
function project(row: any, columns: string) {
  if (!columns || columns.trim()==="*" || columns.includes("(") || columns.includes("!")) return row;
  const out:any={};
  for (const raw of columns.split(",")) { const key=raw.trim().split(/\s+/)[0]; if (key && key in row) out[key]=row[key]; }
  return Object.keys(out).length ? out : row;
}

class LocalQuery implements PromiseLike<LocalResult> {
  private op: "select"|"insert"|"upsert"|"update"|"delete" = "select";
  private payload: any = null;
  private filters: Filter[] = [];
  private singleMode: "none"|"single"|"maybe" = "none";
  private orderSpec: { key: string; ascending: boolean } | null = null;
  private limitCount: number | null = null;
  private rangeSpec: [number,number] | null = null;
  private selectColumns = "*";
  private selectOpts: any = null;
  private onConflict: string | null = null;
  constructor(private table: string) {}
  select(columns="*", opts?: any) { this.selectColumns=columns; this.selectOpts=opts ?? null; return this; }
  insert(payload:any, _opts?:any) { this.op="insert"; this.payload=payload; return this; }
  upsert(payload:any, opts?:any) { this.op="upsert"; this.payload=payload; this.onConflict=opts?.onConflict ?? null; return this; }
  update(payload:any, _opts?:any) { this.op="update"; this.payload=payload; return this; }
  delete(_opts?:any) { this.op="delete"; return this; }
  eq(key:string,value:any){ this.filters.push({key,op:"eq",value}); return this; }
  neq(key:string,value:any){ this.filters.push({key,op:"neq",value}); return this; }
  gt(key:string,value:any){ this.filters.push({key,op:"gt",value}); return this; }
  gte(key:string,value:any){ this.filters.push({key,op:"gte",value}); return this; }
  lt(key:string,value:any){ this.filters.push({key,op:"lt",value}); return this; }
  lte(key:string,value:any){ this.filters.push({key,op:"lte",value}); return this; }
  is(key:string,value:any){ this.filters.push({key,op:"is",value}); return this; }
  in(key:string,value:any[]){ this.filters.push({key,op:"in",value}); return this; }
  not(key:string,operator:string,value:any){ this.filters.push({key,op:`not:${operator}`,value}); return this; }
  like(key:string,value:any){ this.filters.push({key,op:"like",value}); return this; }
  ilike(key:string,value:any){ this.filters.push({key,op:"ilike",value}); return this; }
  contains(key:string,value:any){ this.filters.push({key,op:"contains",value}); return this; }
  overlaps(key:string,value:any){ this.filters.push({key,op:"overlaps",value}); return this; }
  match(values:Record<string,any>){ Object.entries(values||{}).forEach(([k,v])=>this.eq(k,v)); return this; }
  filter(key:string,operator:string,value:any){ this.filters.push({key,op:operator,value}); return this; }
  or(expr:string){ this.filters.push({key:"__or__",op:"or",value:expr}); return this; }
  order(key:string,opts?:any){ this.orderSpec={key,ascending:opts?.ascending!==false}; return this; }
  limit(n:number){ this.limitCount=n; return this; }
  range(from:number,to:number){ this.rangeSpec=[from,to]; return this; }
  single(){ this.singleMode="single"; return this; }
  maybeSingle(){ this.singleMode="maybe"; return this; }
  abortSignal(_signal:AbortSignal){ return this; }
  returns(){ return this; }
  private basic(row:any,f:Filter):boolean {
    const v=row?.[f.key];
    switch(f.op){
      case "eq": return v===f.value;
      case "neq": return v!==f.value;
      case "gt": return v>f.value;
      case "gte": return v>=f.value;
      case "lt": return v<f.value;
      case "lte": return v<=f.value;
      case "is": return f.value===null ? v==null : v===f.value;
      case "in": return Array.isArray(f.value) && f.value.includes(v);
      case "like": return like(v,f.value,false);
      case "ilike": return like(v,f.value,true);
      case "contains": return Array.isArray(v) ? (Array.isArray(f.value)?f.value.every((x:any)=>v.includes(x)):v.includes(f.value)) : typeof v==="object" && typeof f.value==="object" ? Object.entries(f.value).every(([k,x])=>v?.[k]===x) : false;
      case "overlaps": return Array.isArray(v) && Array.isArray(f.value) && f.value.some((x:any)=>v.includes(x));
      case "not:is": return f.value===null ? v!=null : v!==f.value;
      case "not:eq": return v!==f.value;
      default: return true;
    }
  }
  private matches(row:any){
    for(const f of this.filters){
      if(f.op!=="or" && !this.basic(row,f)) return false;
      if(f.op==="or"){
        const parts=String(f.value).split(","); let ok=false;
        for(const part of parts){ const m=/^([^.]+)\.(eq|gt|gte|lt|lte|is)\.(.*)$/.exec(part.trim()); if(!m) continue; let val:any=m[3]==="null"?null:m[3]; if(this.basic(row,{key:m[1],op:m[2],value:val})){ok=true;break;} }
        if(!ok) return false;
      }
    }
    return true;
  }
  private async resolve():Promise<LocalResult>{
    let rows=readLocalRows(this.table); const matched=rows.filter(r=>this.matches(r)); let data:any=null;
    if(this.op==="select"){
      let out=[...matched]; if(this.orderSpec){const {key,ascending}=this.orderSpec;out.sort((a,b)=>cmp(a?.[key],b?.[key])*(ascending?1:-1));}
      if(this.rangeSpec) out=out.slice(this.rangeSpec[0],this.rangeSpec[1]+1); if(this.limitCount!=null) out=out.slice(0,this.limitCount);
      const count=out.length; const projected=out.map(r=>project(r,this.selectColumns)); data=this.selectOpts?.head?null:(this.singleMode==="none"?projected:(projected[0]??null)); return {data,error:null,count:this.selectOpts?.count?count:null,status:200,statusText:"OK"};
    }
    if(this.op==="insert"){
      const incoming=Array.isArray(this.payload)?this.payload:[this.payload]; const created=incoming.map((r:any)=>({id:r?.id??makeId(),user_id:r?.user_id??LOCAL_USER_ID,created_at:r?.created_at??nowIso(),updated_at:r?.updated_at??nowIso(),...r})); rows.push(...created); writeLocalRows(this.table,rows); data=this.singleMode==="none"?created:(created[0]??null);
    } else if(this.op==="upsert"){
      const incoming=Array.isArray(this.payload)?this.payload:[this.payload]; const out:any[]=[]; const keys=(this.onConflict||"id").split(",").map(x=>x.trim()).filter(Boolean);
      for(const r of incoming){const idx=rows.findIndex(x=>keys.every(k=>r?.[k]!=null && x?.[k]===r[k])); if(idx>=0){rows[idx]={...rows[idx],...r,updated_at:nowIso()};out.push(rows[idx]);}else{const c={id:r?.id??makeId(),user_id:r?.user_id??LOCAL_USER_ID,created_at:r?.created_at??nowIso(),updated_at:nowIso(),...r};rows.push(c);out.push(c);}} writeLocalRows(this.table,rows); data=this.singleMode==="none"?out:(out[0]??null);
    } else if(this.op==="update"){
      const out:any[]=[]; rows=rows.map(r=>this.matches(r)?(out.push({...r,...this.payload,updated_at:nowIso()}),out[out.length-1]):r); writeLocalRows(this.table,rows); data=this.singleMode==="none"?out:(out[0]??null);
    } else if(this.op==="delete") { rows=rows.filter(r=>!this.matches(r)); writeLocalRows(this.table,rows); data=null; }
    return {data,error:null,count:Array.isArray(data)?data.length:(data?1:0),status:200,statusText:"OK"};
  }
  then<TResult1=LocalResult,TResult2=never>(onfulfilled?:((value:LocalResult)=>TResult1|PromiseLike<TResult1>)|null,onrejected?:((reason:any)=>TResult2|PromiseLike<TResult2>)|null):PromiseLike<TResult1|TResult2>{return this.resolve().then(onfulfilled??undefined,onrejected??undefined);}
}

