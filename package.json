{
  "name": "resonance-epublisher-sovereign-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/main.tsx",
      "default": "./src/main.tsx"
    },
    "./test-utils": {
      "types": "./dist/types/test-utils/index.d.ts",
      "import": "./src/test-utils/index.ts",
      "default": "./src/test-utils/index.ts"
    },
    "./test-utils/slider-thumb-focus": {
      "types": "./dist/types/test-utils/slider-thumb-focus.d.ts",
      "import": "./src/test-utils/slider-thumb-focus.ts",
      "default": "./src/test-utils/slider-thumb-focus.ts"
    }
  },
  "typesVersions": {
    "*": {
      "test-utils": [
        "./dist/types/test-utils/index.d.ts"
      ],
      "test-utils/slider-thumb-focus": [
        "./dist/types/test-utils/slider-thumb-focus.d.ts"
      ]
    }
  },
  "files": [
    "src/test-utils",
    "dist/types/test-utils"
  ],
  "scripts": {
    "predev": "node scripts/generate-sitemap.mjs && node scripts/generate-robots.mjs && node scripts/compress-sitemap.mjs && node scripts/validate-sitemap.mjs && node scripts/diff-sitemap.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/generate-robots.mjs && node scripts/compress-sitemap.mjs && node scripts/validate-sitemap.mjs && node scripts/diff-sitemap.mjs",
    "build": "vite build",
    "postbuild": "node scripts/verify-dist-sitemap.mjs && node scripts/verify-served-sitemap.mjs",
    "build:dev": "vite build --mode development",
    "build:types": "tsc -p tsconfig.types.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.types.json && node scripts/verify-emitted-types.mjs",
    "stress:edge": "node scripts/edge-stress-harness.mjs",
    "verify:brand": "node scripts/verify-brand-assets.mjs",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "generate:robots": "node scripts/generate-robots.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "postdeploy:seo": "node scripts/post-deploy-seo.mjs",
    "validate:sitemap": "node scripts/validate-sitemap.mjs",
    "diff:sitemap": "node scripts/diff-sitemap.mjs",
    "dev:sovereign": "vite --host localhost --port 3101",
    "preview:sovereign": "vite preview --host localhost --port 3101"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.0.1",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@hookform/resolvers": "^3.10.0",
    "@huggingface/transformers": "^4.3.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.83.0",
    "@types/diff": "7.0.0",
    "@types/file-saver": "^2.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "diff": "7.0.0",
    "embla-carousel-react": "^8.6.0",
    "epub-gen-memory": "^1.1.2",
    "file-saver": "^2.0.5",
    "framer-motion": "^11",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
