# Static-host header rules for the generated SEO files.
# Crawlers reject sitemaps served as text/html or with a wrong charset, so the
# Content-Type is pinned here; the pre-compressed .gz siblings (written by
# scripts/compress-sitemap.mjs) declare Content-Encoding: gzip.

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap-*.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml.gz
  Content-Type: application/xml; charset=utf-8
  Content-Encoding: gzip
  Cache-Control: public, max-age=3600

/sitemap-*.xml.gz
  Content-Type: application/xml; charset=utf-8
  Content-Encoding: gzip
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt.gz
  Content-Type: text/plain; charset=utf-8
  Content-Encoding: gzip
  Cache-Control: public, max-age=3600
